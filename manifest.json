{
  "manifest_version": 3,
  "name": "ExcaliFree",
  "version": "1.2.0",
  "description": "Pages, frame slideshows, LaTeX formulas, auto-save and OneDrive sync for Excalidraw",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "debugger"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://api.onedrive.com/*",
    "https://*.1drv.com/*",
    "https://*.microsoftpersonalcontent.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excalidraw.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "src/content.css"
      ]
    },
    {
      "matches": [
        "https://excalidraw.com/*"
      ],
      "js": [
        "dist/bridge.js"
      ],
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/latex.js"
      ],
      "matches": [
        "https://excalidraw.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "description": "Open / close the ExcaliFree panel"
    }
  }
}
